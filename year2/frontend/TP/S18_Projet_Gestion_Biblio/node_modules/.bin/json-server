#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/json-server@1.0.0-beta.5/node_modules/json-server/lib/node_modules:/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/json-server@1.0.0-beta.5/node_modules/json-server/node_modules:/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/json-server@1.0.0-beta.5/node_modules:/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/json-server@1.0.0-beta.5/node_modules/json-server/lib/node_modules:/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/json-server@1.0.0-beta.5/node_modules/json-server/node_modules:/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/json-server@1.0.0-beta.5/node_modules:/home/hani/studies/year2/frontend/TP/S18_Projet_Gestion_Biblio/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../json-server/lib/bin.js" "$@"
else
  exec node  "$basedir/../json-server/lib/bin.js" "$@"
fi
